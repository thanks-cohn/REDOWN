{
  "name": "remote-asset-ingest",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "diagnostics": "node agent/diagnostics/cli.mjs",
    "reliability:check": "node scripts/reliability-check.mjs",
    "reliability:release": "node scripts/reliability-check.mjs --strict",
    "bridge": "node local/bridge.mjs",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "storage:benchmark": "node scripts/storage-expansion-benchmark.mjs",
    "storage:preview": "node scripts/storage-signals-preview.mjs",
    "runtime:describe": "node agent/runtime/cli.mjs describe",
    "runtime:chrome": "node scripts/installed-chrome.mjs",
    "package:audit": "python scripts/package_chrome_store.py --audit-only",
    "explorer:preview": "node scripts/explorer-operations-preview.mjs",
    "explorer:describe": "node agent/explorer/cli.mjs describeExplorer",
    "explorer:smoke": "node scripts/explorer-smoke.mjs",
    "beta:acceptance": "node scripts/beta-walkthrough-acceptance.mjs",
    "beta:selftest": "node scripts/beta-core-acceptance.mjs",
    "file:unit": "node --test tests/phase2-engine.test.mjs tests/universal-file-engine.test.mjs tests/r2-laboratory-transport.test.mjs tests/universal-file-discovery.test.mjs",
    "file:schema": "python tests/universal-file-schema.py",
    "file:catalog": "node scripts/r2-lab/catalog.mjs",
    "file:preservation": "node scripts/r2-lab/preservation.mjs",
    "file:verify": "npm run file:unit && npm run file:schema && npm run file:preservation",
    "file:live": "node scripts/r2-lab/live.mjs",
    "file:live-ui": "node scripts/r2-lab/ui.mjs",
    "file:prepare": "node scripts/r2-lab/prepare.mjs",
    "file:deployment-plan": "node scripts/r2-lab/deployment-plan.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.6",
    "jsdom": "^26.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@google/model-viewer": "^4.1.0"
  }
}
