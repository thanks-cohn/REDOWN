  "ownership": [
    {
      "subject": "project.current-relationships",
      "owner": "semantic.projectOverview",
      "related": [
        "project.projectOverview"
      ],
      "boundary": "Proposed current relationships and historical source catalog are different evidence"
    },
    {
      "subject": "incident.history",
      "owner": "debug.listIncidents",
      "related": [
        "explorer.findRelatedIncidents"
      ],
      "boundary": "Historical DBG cases and Explorer operational incidents have distinct identifiers"
    },
    {
      "subject": "explorer.operation-contract",
      "owner": "explorer.explainOperation",
      "related": [
        "project.explainOperation"
      ],
      "boundary": "Explorer uses name; historical project operation uses catalog id"
    },
    {
      "subject": "explorer.trace",
      "owner": "explorer.getOperationTrace",
      "related": [
        "runtime.listTraces"
      ],
      "boundary": "Trace/event IDs are namespace-scoped; never join by matching text alone"
    },
    {
      "subject": "runtime.events",
      "owner": "runtime.listTraces",
      "related": [
        "explorer.getRecentFailures"
      ],
      "boundary": "Passive runtime codes and Explorer codes keep separate meanings"
    },
    {
      "subject": "verification.latest-local",
      "owner": "diagnostics.getVerificationStatus",
      "related": [],
      "boundary": "Local report freshness is scoped and unauthenticated"
    },
    {
      "subject": "release.requirements",
      "owner": "diagnostics.getReleaseReadiness",
      "related": [],
      "boundary": "Recorded gates do not establish current live readiness"
    },
    {
      "subject": "test.presets",
      "owner": "explorer.listSmokePresets",
      "related": [
        "diagnostics.getTestPlan"
      ],
      "boundary": "The gateway constructs plans from the existing Explorer smoke catalog"
    },
    {
      "subject": "architecture.explorer",
      "owner": "explorer.validateArchitecture",
      "related": [
        "semantic.traceDependencies"
      ],
      "boundary": "Source anchors are not proof of runtime execution"
    },
    {
      "subject": "issues.current-inventory",
      "owner": "diagnostics.listIssues",
      "related": [
        "debug.listIncidents",
        "explorer.findRelatedIncidents"
      ],
      "boundary": "Current assessments are hash-bound review notes; original reports, historical lifecycle and runtime observations are separate evidence"
    },
    {
      "subject": "canonical-file-operations",
      "owner": "explorer.getConnectorCapabilities",
      "related": [
        "diagnostics.getProjectMap",
        "explorer.explainOperation"
      ]
    },
    {
      "subject": "resource-performance-memory",
      "owner": "resources.describe",
      "related": [
        "resources.getTrace",
        "resources.getBottlenecks"
      ]
    },
    {
      "subject": "agent-accessibility-conformance",
      "owner": "aac.describe",
      "related": [
        "aac.getReport",
        "aac.listGaps",
        "aac.getCapability"
      ]
    }
  ],
  "unimplemented": [
    "accepted Forever Works purpose model",
    "general execution API",
    "complete live cross-context tracing",
    "complete project call graph",
    "additional cloud/filesystem connectors"
  ]
}
