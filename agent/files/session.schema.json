{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:redown:files:1.0.0:session",
  "type": "object",
  "properties": {
    "method": {
      "enum": [
        "describe",
        "execute",
        "plan",
        "inspect",
        "evidence",
        "cancel",
        "reconcile",
        "resources",
        "jobs"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "request": {
          "oneOf": [
            {
              "$ref": "urn:redown:file-api:0.2.0#/$defs/request"
            },
            {
              "$ref": "urn:redown:file-api:0.3.0#/$defs/request"
            }
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "metric": {
          "enum": [
            "getTrace",
            "getLatencyBreakdown",
            "getMemoryProfile",
            "explainSlowdown"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "method"
  ],
  "additionalProperties": false
}
