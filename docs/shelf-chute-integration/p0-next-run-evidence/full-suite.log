{display:block;height:1.35em}.counter-note{font-size:10px;color:#ba9ed0;margin:9px 0 0}.status{font-size:11px;color:var(--muted);margin:12px 0 0;overflow-wrap:anywhere}.status:empty{display:none}[hidden]{display:none!important}@media(prefers-reduced-motion:reduce){.reel,.dashboard{transition:none}.connection[data-state="checking"] .light{animation:none}}\n  </style>\n<link rel="stylesheet" href="save-impact.css"></head>\n<body><main class="shell"><section id="recovery" hidden><p>REDOWN opened in recovery mode because the Shelf could not open.</p><button id="retry-shelf" type="button">Retry Shelf</button><button id="support-report" type="button">Export support report</button><p id="recovery-status" role="status"></p></section>\n  <header><div class="brand"><img src="icon.svg" alt=""><div><div class="wordmark">REDOWN</div><div class="tag">Your cloud companion ✦</div></div></div><button id="connection" class="connection" type="button" data-state="checking" aria-label="Checking Cloudflare connection" title="Checking Cloudflare connection"><span class="light" aria-hidden="true"></span></button></header>\n  <button id="dashboard" class="dashboard" type="button" title="Open REDOWN Home">Go to Dashboard <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true" focusable="false"><path d="M3.5 10.2 11.1 3.7a1.4 1.4 0 0 1 1.8 0l7.6 6.5V19a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-8.8Z"/><path d="M9.2 21v-5.5a2.8 2.8 0 0 1 5.6 0V21"/><path d="M17 12.5h1.5v1.5H17z"/></svg></button>\n  <button id="shelf-settings" class="settings-link" type="button" title="Open Shelf Settings">Settings</button>\n  <p class="hint">Your files. Your destinations. All in one place.</p>\n  <section class="counter-panel" aria-label="Delivery counter"><div class="counter-heading"><div class="counter-label">Files delivered</div><button id="counter-sound" class="sound" type="button" disabled aria-pressed="true" title="Mute counter sound">Sound on ♪</button></div><button id="odometer" class="odometer" type="button" aria-label="Checking Cloudflare connection" disabled></button><p id="counter-note" class="counter-note">Warming up…</p></section>\n  <p id="status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>\n</main><script src="toolbar-appearance.js"></script><script src="popup-recovery.js"></script><script src="odometer.js"></script><script src="shelf-click-feedback.js"></script><script src="shelf-save-feedback.js"></script><script src="popup.js"></script></body>\n</html>\n',
