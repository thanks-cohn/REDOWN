{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:redown:diagnostic:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "timestamp",
    "traceId",
    "spanId",
    "parentSpanId",
    "operationId",
    "component",
    "stage",
    "operation",
    "provider",
    "severity",
    "outcome",
    "code",
    "nativeCode",
    "httpStatus",
    "requestId",
    "method",
    "mutationPhase",
    "retrySafety",
    "causes",
    "evidenceRefs",
    "actionableRecovery",
    "confidence",
    "missingEvidence",
    "redactionVersion",
    "dataSensitivity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "redown.diagnostic.v1"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "pattern": "^(?!0{32}$)[a-f0-9]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^(?!0{16}$)[a-f0-9]{16}$"
    },
    "parentSpanId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!0{16}$)[a-f0-9]{16}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "component": {
      "enum": [
        "coordinator",
        "provider-adapter",
        "worker-transport",
        "session",
        "native",
        "python",
        "worker",
        "doctor"
      ]
    },
    "stage": {
      "enum": [
        "execution",
        "object.stat",
        "object.read",
        "object.list",
        "worker.settings",
        "worker.subdomain",
        "worker.capabilities",
        "worker.create",
        "write.verify",
        "connection",
        "doctor",
        "validation"
      ]
    },
    "operation": {
      "enum": [
        "unknown",
        "doctor",
        "list",
        "metadata",
        "read",
        "upload",
        "ingest",
        "mkdir",
        "copy",
        "move",
        "rename",
        "delete"
      ]
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "severity": {
      "enum": [
        "ERROR",
        "WARN",
        "INFO"
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNSUPPORTED",
        "NOT_TESTED",
        "INDETERMINATE"
      ]
    },
    "code": {
      "enum": [
        "AUTHORIZATION_DENIED",
        "AUTHORIZATION_REVOKED_OR_EXPIRED",
        "CANCELLED",
        "CAPACITY",
        "CONFIRMATION_REQUIRED",
        "CONFLICT",
        "DELETE_UNCONFIRMED",
        "DESTINATION_CHANGED",
        "DIAGNOSTICS_LOST",
        "EXTENSION_DISCONNECTED",
        "EXTENSION_UNAVAILABLE",
        "HMAC",
        "IDEMPOTENCY_CONFLICT",
        "IDEMPOTENCY_HISTORY_EXPIRED",
        "INCOMPATIBLE_JOURNAL",
        "INCOMPATIBLE_VERSION",
        "INTERRUPTED",
        "INVALID_BATCH",
        "INVALID_BYTES",
        "INVALID_CURSOR",
        "INVALID_ENDPOINT",
        "INVALID_IDENTITY",
        "INVALID_INPUT",
        "INVALID_PROVIDER_RESPONSE",
        "INVALID_RANGE",
        "INVALID_REQUEST",
        "INVALID_SCOPE",
        "INVALID_TRANSITION",
        "JOURNAL_MISSING",
        "LAB_WORKER_BINDING_MISMATCH",
        "LAB_WORKER_IDENTITY_REQUIRED",
        "LAB_WORKER_NOT_CONFIGURED",
        "LAB_WORKER_SETTINGS_DENIED",
        "LAB_WORKER_SETTINGS_UNAVAILABLE",
        "LAB_WORKER_UNAVAILABLE",
        "LAB_WORKER_UPDATE_REQUIRED",
        "NETWORK_FAILURE",
        "NOT_CANCELLABLE",
        "NOT_FOUND_OR_INACCESSIBLE",
        "OPERATION_BUDGET",
        "PAIRING_REJECTED",
        "PAIRING_TIMEOUT",
        "POST",
        "PROVIDER_BAD_REQUEST",
        "PROVIDER_ERROR",
        "PROVIDER_METHOD_UNSUPPORTED",
        "PROVIDER_NOT_FOUND",
        "PROVIDER_OPERATION_UNSUPPORTED",
        "PROVIDER_PERMISSION_DENIED",
        "PROVIDER_SERVICE_ERROR",
        "RATE_LIMITED",
        "RESPONSE_BUDGET",
        "SCOPE_DENIED",
        "SELF_TARGET",
        "SESSION_CLOSED",
        "SESSION_EXPIRED",
        "SIZE_LIMIT",
        "SOURCE_CHANGED",
        "STORAGE",
        "TIMEOUT",
        "TIMEOUT_UNCERTAIN",
        "TRACE_ID_CONFLICT",
        "TRANSPORT_FAILURE",
        "TRUNCATED_READ",
        "UNSUPPORTED_ATOMIC_CREATE",
        "UNSUPPORTED_ATOMIC_DELETE",
        "UNSUPPORTED_CONFLICT_POLICY",
        "UNSUPPORTED_OPERATION",
        "UNSUPPORTED_PROVIDER",
        "VERIFICATION_DISAGREEMENT",
        "WRITE_UNCERTAIN"
      ]
    },
    "nativeCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{3,8}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "httpStatus": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ]
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{16,32}(?:-[A-Z]{3,5})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "DELETE",
        null
      ]
    },
    "mutationPhase": {
      "enum": [
        "NOT_SUBMITTED",
        "SUBMITTED_REJECTED",
        "ACKNOWLEDGED_UNVERIFIED",
        "VERIFIED",
        "INDETERMINATE"
      ]
    },
    "retrySafety": {
      "enum": [
        "SAFE_WITH_FRESH_ID",
        "RECONCILE_FIRST",
        "DO_NOT_RETRY",
        "UNKNOWN"
      ]
    },
    "causes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/cause"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "actionableRecovery": {
      "enum": [
        "Inspect read-only Doctor before any write",
        "Inspect persisted state independently; never replay an ambiguous write"
      ]
    },
    "confidence": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "UNKNOWN"
      ]
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "live-session",
          "provider-response",
          "write-acknowledgement",
          "independent-readback",
          "deployment-identity"
        ]
      }
    },
    "redactionVersion": {
      "const": "allowlist-1"
    },
    "dataSensitivity": {
      "const": "REDACTED"
    }
  },
