{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redown.local/schemas/diagnostics/registry-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "gatewayVersion",
    "limits",
    "gateway",
    "namespaces",
    "aliases",
    "ownership",
    "unimplemented"
  ],
  "properties": {
    "registryVersion": {
      "const": "1.0.0"
    },
    "gatewayVersion": {
      "const": "1.1.0"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputBytes",
        "responseBytes",
        "explorerBundleBytes",
        "runtimeBundleBytes"
      ],
      "properties": {
        "inputBytes": {
          "const": 8192
        },
        "responseBytes": {
          "const": 524288
        },
        "explorerBundleBytes": {
          "const": 262144
        },
        "runtimeBundleBytes": {
          "const": 196608
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operations"
      ],
      "properties": {
        "id": {
          "const": "diagnostics"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "arguments"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]+$"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "integer",
                        "array"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "namespaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "cli",
          "discovery",
          "scope",
          "versionField",
          "authority",
          "operations",
          "excluded"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "cli": {
            "type": "string",
            "minLength": 1
          },
          "discovery": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "versionField": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "arguments"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]+$"
                },
                "arguments": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "string",
                          "integer",
                          "array"
                        ]
                      },
                      "required": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          },
          "excluded": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z]+\\.[A-Za-z][A-Za-z0-9]+$"
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "owner",
          "related",
          "boundary"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "boundary": {
            "type": "string"
          }
        }
      }
    },
    "unimplemented": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
