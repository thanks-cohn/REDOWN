{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "assessments"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "severity",
          "reviewedOn",
          "summary",
          "evidence",
          "nextAction",
          "related"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "newIssue": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "maxLength": 400
          },
          "reportSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "partially-addressed",
              "source-implemented",
              "source-risk"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "reviewedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "symbol",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?:extension|scripts|tests|docs|agent|bugs)/[A-Za-z0-9._/-]+$"
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "nextAction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "related": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          }
        }
      }
    }
  }
}
